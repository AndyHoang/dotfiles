# Path to your oh-my-zsh installation.
#zmodload zsh/zprof
export ZSH=$HOME/.oh-my-zsh

ZSH_THEME="avit"
DISABLE_AUTO_UPDATE="true"
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="true"
#plugins=(git fzf fzf-tab z ssh-agent kubectl zsh-autosuggestions)
plugins=(direnv git ssh-agent ssm)

zstyle :omz:plugins:ssh-agent identities id_ed25519 id_ed25519_github
export DOCKER_DEFAULT_PLATFORM=linux/amd64
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS="1"

export FZF_CTRL_T_COMMAND=""

source $ZSH/oh-my-zsh.sh

# User configuration
export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
export EDITOR='nvim'

alias vi="nvim"

#continue download
alias wget="wget -c"

# k9s freq update made too many breaking change, im use mise to control k9s version instead
alias k9s="mise x -- k9s "
alias pre-commit="mise x -- pre-commit "
alias bunx="mise x -- bunx"
alias bun="mise x -- bun"
alias gt="mise x -- gt"
alias ucp="mise x -- ucp"

export FZF_DEFAULT_COMMAND='rg --files --no-ignore --hidden --follow --glob "!.git/*"'

# Use when vi **
_fzf_compgen_path() {
   fd --hidden --follow --exclude ".git" "$1"
}

# Use when cd **
_fzf_compgen_dir() {
  fd --type d --hidden --follow --exclude ".git" "$1"
}

eval "$(zoxide init zsh)"

export PATH="/opt/homebrew/opt/ncurses/bin:$PATH"

kpp() {
    local context="$1"
    local namespace="$2"
    local profile="${3:-apollo}"  # Default to my_profile if not provided
    # Check AWS SSO token validity and login if needed
    if ! aws sts get-caller-identity --profile "$profile" &>/dev/null; then
        echo "AWS SSO token expired or not found. Logging in..."
        aws sso login --profile="$profile"
        # Check if login was successful
        if ! aws sts get-caller-identity --profile "$profile" &>/dev/null; then
            echo "AWS SSO login failed. Please try again."
            return 1
        fi
    fi
    export _C=$(kubectl config get-contexts -o name | gum filter --limit 1 --indicator=" >" --value="$context" --select-if-one) && \
    kubectl config use-context $_C && \
    export _X=$(kubectl get ns --no-headers -o custom-columns=":metadata.name" | gum filter --limit 1 --indicator=" >" --value="$namespace" --select-if-one) && \
    k9s -n $_X -c pods
}

alias tree="tree -I '__pycache__|*.pyc|.git|node_modules|.venv|.mypy_cache|.pytest_cache|.ruff_cache|dist|build|*.egg-info'"

